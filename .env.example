# Lemon Squeezy — store & product info
# Store subdomain, e.g. "voltex" for https://voltex.lemonsqueezy.com
LEMONSQUEEZY_STORE_SLUG=voltex
# Checkout URL for the product/variant customers buy (Lemon Squeezy > Product > Share/Checkout link)
LEMONSQUEEZY_CHECKOUT_URL=https://voltex.lemonsqueezy.com/checkout/buy/7246cbb6-0631-428c-a2ba-74b6cec3207b
# Lemon Squeezy API key (Settings > API), used only by server-side functions, never exposed to the client
LEMONSQUEEZY_API_KEY=
# Webhook signing secret (Settings > Webhooks), used to verify incoming Lemon Squeezy webhook requests
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional: forward every new client registration (form signup or completed order) to an
# external endpoint you control (Zapier, Make, Google Sheets webhook, your own API, etc.)
# so client emails are stored somewhere durable. Leave empty to just log registrations.
CLIENTS_WEBHOOK_URL=
