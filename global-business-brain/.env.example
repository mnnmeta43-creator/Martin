# ─────────────────────────────────────────────────────────────────────────────
# Global Business Brain — variablat e mjedisit (shembull, PA sekrete)
# Kopjojeni në .env.local për zhvillim. Asnjë nga këto nuk dërgohet në shfletues.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL për prodhim. Pa këtë, në zhvillim përdoret databaza e brendshme PGlite (.data/pglite).
# Në prodhim pa DATABASE_URL: llogaritë dhe projektet NUK funksionojnë (aplikacioni e tregon qartë).
DATABASE_URL=
# Vetëm për demonstrim/test: lejon PGlite edhe me NODE_ENV=production (p.sh. testet e2e).
ALLOW_EMBEDDED_DB=
# Dosja e PGlite në zhvillim ("memory://" = në memorie, humbet pas rinisjes).
PGLITE_DATA_DIR=.data/pglite

# "live" (parazgjedhje) ose "demo". Në "demo" aktivizohen ekonomitë fiktive ZZA/ZZB/ZZC
# me të dhëna të shënuara qartë DEMO. Të dhënat demo nuk përdoren kurrë për rekomandime reale.
DATA_MODE=live

# Asistenti AI (Claude). Pa këtë çelës: biseda e lirë me AI është e çaktivizuar;
# përgjigjet deterministe të kalkulatorit dhe planit vazhdojnë të funksionojnë.
ANTHROPIC_API_KEY=
# Opsionale: modeli i Claude (parazgjedhja është në src/lib/ai/assistant.ts).
ANTHROPIC_MODEL=

# Sekreti për endpoint-in e rifreskimit automatik POST /api/cron/refresh
# (thirret nga një planifikues: Vercel Cron, Netlify Scheduled Functions, cron në server).
# Pa këtë, rifreskimi automatik është i çaktivizuar; mund të përdorni "npm run data:refresh".
CRON_SECRET=

# Opsionale: baza e API-së së kurseve ECB (Frankfurter). Parazgjedhja: https://api.frankfurter.dev/v1
FX_API_BASE_URL=

# Opsionale: URL publike e aplikacionit (për kontrollin e origjinës në kërkesat POST/PUT/DELETE).
APP_URL=
